# EAS Build usa este archivo EN LUGAR de .gitignore al subir el proyecto.
# Es igual a .gitignore, pero deja pasar google-services.json y GoogleService-Info.plist
# (están fuera de git, pero la build los necesita). Mantén ambos archivos sincronizados.

# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

serviceAccountKey.json
*-firebase-adminsdk-*.json
