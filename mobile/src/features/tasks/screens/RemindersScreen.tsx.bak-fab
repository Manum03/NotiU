
import React, { useCallback, useMemo, useState } from 'react';
import {
  Alert,
  Modal,
  ActivityIndicator,
  Pressable,
  RefreshControl,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
} from 'react-native';
import { useFocusEffect } from '@react-navigation/native';
import { LinearGradient } from 'expo-linear-gradient';
import { Lucide } from '@react-native-vector-icons/lucide';
import type { NativeStackScreenProps } from '@react-navigation/native-stack';

import { FONTS } from '../../../core/theme/fonts';
import { COLORS } from '../../subjects/types';
import BottomNavigation from '../../home/components/BottomNavigation';
import type { RootStackParamList } from '../../../navigation/AppNavigator';
import { apiRequest } from '../../../services/api/api';
import { getSession } from '../../../services/storage/authStorage';

type Props = NativeStackScreenProps<RootStackParamList, 'Tasks'>;

type Task = {
  id: string;
  title: string;
  description: string;
  type: 'tarea' | 'recordatorio' | 'nota';
  status: 'pendiente' | 'en_curso' | 'realizada';
  priority: 'baja' | 'media' | 'alta';
  subjectId: string | null;
  dueDate: string | null;
  dueTime: string | null;
  subtasks?: {
    id: string;
    title: string;
    completed: boolean;
  }[];
};

type TasksResponse = {
  tasks: Task[];
  total: number;
};

type Filter = 'todo' | 'nota' | 'recordatorio' | 'checklist' | 'tarea';

const FILTERS: { id: Filter; label: string }[] = [
  { id: 'todo', label: 'Todo' },
  { id: 'nota', label: 'Notas' },
  { id: 'recordatorio', label: 'Recordatorios' },
  { id: 'checklist', label: 'Checklists' },
  { id: 'tarea', label: 'Tareas' },
];

type TaskCategory = Exclude<Filter, 'todo'>;

function getTaskCategory(task: Task): TaskCategory {
  if (task.type === 'nota') return 'nota';
  if (task.type === 'recordatorio') return 'recordatorio';
  if (task.subtasks && task.subtasks.length > 0) return 'checklist';
  return 'tarea';
}

function formatDate(value: string | null) {
  if (!value) return 'Sin fecha';

  const parts = value.slice(0, 10).split('-');
  if (parts.length !== 3) return value;

  const [year, month, day] = parts;
  return `${day}/${month}/${year}`;
}

export default function RemindersScreen({ navigation }: Props) {
  const [tasks, setTasks] = useState<Task[]>([]);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [error, setError] = useState('');
  const [search, setSearch] = useState('');
  const [activeFilter, setActiveFilter] = useState<Filter>('todo');
  const [filtersOpen, setFiltersOpen] = useState(false);
  const [showCreateMenu, setShowCreateMenu] = useState(false);
  const [selectedTask, setSelectedTask] = useState<Task | null>(null);

  const loadTasks = useCallback(async (showLoader = true) => {
    try {
      if (showLoader) setLoading(true);
      setError('');

      const session = await getSession();

      if (!session?.token) {
        throw new Error('No se encontró una sesión activa.');
      }

      const response = await apiRequest<TasksResponse>('/tasks', {
        method: 'GET',
        token: session.token,
      });

      setTasks(response.tasks ?? []);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : 'No se pudieron cargar tus actividades.'
      );
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, []);

  useFocusEffect(
    useCallback(() => {
      loadTasks();
    }, [loadTasks])
  );

  const onRefresh = useCallback(() => {
    setRefreshing(true);
    loadTasks(false);
  }, [loadTasks]);

  const counts = useMemo(() => ({
    nota: tasks.filter(task => getTaskCategory(task) === 'nota').length,
    recordatorio: tasks.filter(task => getTaskCategory(task) === 'recordatorio').length,
    checklist: tasks.filter(task => getTaskCategory(task) === 'checklist').length,
    tarea: tasks.filter(task => getTaskCategory(task) === 'tarea').length,
  }), [tasks]);

  const filteredTasks = useMemo(() => {
    const normalizedSearch = search.trim().toLowerCase();

    return tasks.filter(task => {
      const category = getTaskCategory(task);

      const matchesFilter =
        activeFilter === 'todo' || category === activeFilter;

      const matchesSearch =
        !normalizedSearch ||
        task.title.toLowerCase().includes(normalizedSearch) ||
        (task.description ?? '').toLowerCase().includes(normalizedSearch);

      return matchesFilter && matchesSearch;
    });
  }, [tasks, search, activeFilter]);
  
    const completeTask = async (taskId: string) => {
    try {
      const session = await getSession();

      if (!session?.token) {
        throw new Error('No se encontró una sesión activa.');
      }

      await apiRequest(`/tasks/${taskId}/complete`, {
        method: 'PATCH',
        token: session.token,
      });

      await loadTasks(false);
    } catch (err) {
      Alert.alert(
        'No se pudo completar',
        err instanceof Error ? err.message : 'Inténtalo de nuevo.'
      );
    }
  };
  const toggleSubtask = async (task: Task, subtaskId: string) => {
  const updatedSubtasks = (task.subtasks ?? []).map(subtask =>
    subtask.id === subtaskId
      ? { ...subtask, completed: !subtask.completed }
      : subtask
  );

  try {
    const session = await getSession();

    if (!session?.token) {
      throw new Error('No se encontró una sesión activa.');
    }

    await apiRequest(`/tasks/${task.id}`, {
      method: 'PATCH',
      token: session.token,
      body: JSON.stringify({
        subtasks: updatedSubtasks,
      }),
    });

    await loadTasks(false);
  } catch (err) {
    Alert.alert(
      'No se pudo actualizar la lista',
      err instanceof Error ? err.message : 'Inténtalo de nuevo.'
    );
  }
};
  const openForm = (type: 'tarea' | 'recordatorio' | 'nota' | 'checklist') => {
    setShowCreateMenu(false);
    navigation.navigate('AddTask', { type });
  };

  const closeTaskActions = () => {
    setSelectedTask(null);
  };

  const archiveTask = async () => {
    if (!selectedTask) return;

    try {
      const session = await getSession();

      if (!session?.token) {
        throw new Error('No se encontró una sesión activa.');
      }

      await apiRequest(`/tasks/${selectedTask.id}/archive`, {
        method: 'PATCH',
        token: session.token,
      });

      setSelectedTask(null);
      await loadTasks(false);
    } catch (err) {
      Alert.alert(
        'No se pudo archivar',
        err instanceof Error ? err.message : 'Inténtalo de nuevo.'
      );
    }
  };

  const deleteSelectedTask = () => {
    if (!selectedTask) return;

    const taskToDelete = selectedTask;

    Alert.alert(
      'Eliminar actividad',
      `¿Seguro que deseas eliminar "${taskToDelete.title}"? Esta acción no se puede deshacer.`,
      [
        {
          text: 'Cancelar',
          style: 'cancel',
        },
        {
          text: 'Eliminar',
          style: 'destructive',
          onPress: async () => {
            try {
              const session = await getSession();

              if (!session?.token) {
                throw new Error('No se encontró una sesión activa.');
              }

              await apiRequest(`/tasks/${taskToDelete.id}`, {
                method: 'DELETE',
                token: session.token,
              });

              setSelectedTask(null);
              await loadTasks(false);
            } catch (err) {
              Alert.alert(
                'No se pudo eliminar',
                err instanceof Error ? err.message : 'Inténtalo de nuevo.'
              );
            }
          },
        },
      ]
    );
  };
  const renderTaskCard = (task: Task) => {
    const category = getTaskCategory(task);
    const completed = task.status === 'realizada';
    const totalSubtasks = task.subtasks?.length ?? 0;
    const completedSubtasks =
      task.subtasks?.filter(item => item.completed).length ?? 0;

    const categoryInfo = {
      nota: {
        label: 'NOTA PERSONAL',
        icon: 'notebook-pen' as const,
      },
      recordatorio: {
        label: 'RECORDATORIO',
        icon: 'bell-ring' as const,
      },
      checklist: {
        label: 'CHECKLIST',
        icon: 'list-checks' as const,
      },
      tarea: {
        label: 'TAREA',
        icon: 'clipboard-list' as const,
      },
    }[category];

    const cardPalette = {
      tarea: {
        gradient: ['#81243D', '#64172C', '#3B101D'] as const,
        accent: '#D18A9C', border: '#8C4056',
        text: '#F4E4E8', muted: '#D7B8C1', soft: '#C79AA7',
        pending: '#E6A0B0', progress: '#D27A91', completed: '#C9AEB7',
        iconBg: '#4E1A2A', buttonBg: '#4E1525',
      },
      recordatorio: {
        gradient: ['#63303F', '#4A202D', '#32151E'] as const,
        accent: '#C58A98', border: '#79404F',
        text: '#F0E1E4', muted: '#D2B6BC', soft: '#B9959E',
        pending: '#D9A0AA', progress: '#C77D8D', completed: '#C6ADB3',
        iconBg: '#48232D', buttonBg: '#40202A',
      },
      nota: {
        gradient: ['#624657', '#493242', '#30202D'] as const,
        accent: '#D0A5BA', border: '#866176',
        text: '#F1E5EB', muted: '#D9C3CE', soft: '#C1A4B3',
        pending: '#D6A9C0', progress: '#C18DAA', completed: '#CDBBC5',
        iconBg: '#493344', buttonBg: '#3B2938',
      },
      checklist: {
        gradient: ['#572A49', '#3D1C35', '#24101F'] as const,
        accent: '#C29AB8', border: '#74445F',
        text: '#F0E3EC', muted: '#D4BDCE', soft: '#BDA0B5',
        pending: '#D1A4C1', progress: '#B989AA', completed: '#C8B5C4',
        iconBg: '#40243A', buttonBg: '#321B2D',
      },
    }[category];

    return (
      <Pressable
        key={task.id}
        delayLongPress={700}
        onLongPress={() => {

          setShowCreateMenu(false);
          setSelectedTask(task);
        }}
      >
      <LinearGradient
        style={[
          styles.taskCard,
          {
            borderColor: cardPalette.border,
            backgroundColor: cardPalette.gradient[0],
          },
        ]}
        colors={cardPalette.gradient}
        start={{ x: 0, y: 0 }}
        end={{ x: 1, y: 1 }}
      >
        <View style={styles.cardTop}>
          <View style={styles.categoryRow}>
            <View style={[styles.categoryIcon, { backgroundColor: cardPalette.iconBg, borderColor: cardPalette.border, borderWidth: 1 }]}>
              <Lucide
                name={categoryInfo.icon}
                size={16}
                color={cardPalette.accent}
              />
            </View>
            <Text style={[styles.categoryLabel, { color: cardPalette.accent }]}>
              {categoryInfo.label}
            </Text>
          </View>

          <View style={[
            styles.statusDot,
            {
              backgroundColor: completed
                ? cardPalette.completed
                : task.status === 'en_curso'
                  ? cardPalette.progress
                  : cardPalette.pending,
            },
          ]} />
        </View>

        <Text style={[
          styles.taskTitle,
          completed && styles.completedText,
        ]}>
          {task.title}
        </Text>

        {!!task.description && (
          <Text style={styles.taskDescription} numberOfLines={2}>
            {task.description}
          </Text>
        )}

        
        {category === 'checklist' && (
          <View style={styles.checklistProgress}>
            <View style={styles.checklistProgressText}>
              <Text style={styles.progressLabel}>PROGRESO DE LA LISTA</Text>
              <Text style={styles.progressNumber}>
                {completedSubtasks}/{totalSubtasks}
              </Text>
            </View>

            <View style={styles.progressTrack}>
              <View
                style={[
                  styles.progressFill,
                  {
                    width: `${totalSubtasks
                      ? (completedSubtasks / totalSubtasks) * 100
                      : 0}%`,
                  },
                ]}
              />
            </View>

            <View style={styles.subtaskList}>
              {task.subtasks?.map(subtask => (
                <Pressable
                  key={subtask.id}
                  style={styles.subtaskRow}
                  onPress={() => toggleSubtask(task, subtask.id)}
                >
                  <Lucide
                    name={subtask.completed ? 'circle-check' : 'circle'}
                    size={19}
                    color={subtask.completed ? '#F9D1D7' : '#D8BFBC'}
                  />

                  <Text
                    style={[
                      styles.subtaskText,
                      subtask.completed && styles.subtaskCompleted,
                    ]}
                  >
                    {subtask.title}
                  </Text>
                </Pressable>
              ))}
            </View>
          </View>
        )}


        <View style={styles.cardFooter}>
          <View style={styles.dateRow}>
            <Lucide
              name="calendar-days"
              size={14}
              color={cardPalette.soft}
            />
            <Text style={[styles.dateText, { color: cardPalette.soft }]}>
              {formatDate(task.dueDate)}
            </Text>
          </View>

          {task.dueTime && (
            <View style={styles.dateRow}>
              <Lucide name="clock-3" size={14} color={cardPalette.soft} />
              <Text style={[styles.dateText, { color: cardPalette.soft }]}>{task.dueTime}</Text>
            </View>
          )}

          <Text style={[
            styles.stateText,
            {
              color: completed
                ? cardPalette.completed
                : task.status === 'en_curso'
                  ? cardPalette.progress
                  : cardPalette.pending,
            },
          ]}>
            {completed
              ? 'COMPLETADA'
              : task.status === 'en_curso'
                ? 'EN CURSO'
                : 'PENDIENTE'}
          </Text>
        </View>
                <View style={styles.cardActions}>
          <Pressable
            style={[
              styles.editButton,
              {
                backgroundColor: cardPalette.iconBg,
                borderColor: cardPalette.border,
              },
            ]}
            onPress={() =>
              navigation.navigate('AddTask', {
              type: category === 'checklist' ? 'checklist' : task.type,
              taskId: task.id,
              })
            }
          >
            <Lucide name="pencil" size={15} color={cardPalette.accent} />
            <Text style={[styles.editButtonText, { color: cardPalette.accent }]}>Editar</Text>
          </Pressable>
                    {!completed && (
            <Pressable
              style={[
                styles.completeButton,
                {
                  backgroundColor: cardPalette.accent,
                  borderColor: cardPalette.accent,
                },
              ]}
              onPress={() => completeTask(task.id)}
            >
              <Lucide name="check" size={15} color={cardPalette.gradient[2]} />
              <Text style={[styles.completeButtonText, { color: cardPalette.gradient[2] }]}>Completar</Text>
            </Pressable>
          )}
        </View>
      </LinearGradient>
      </Pressable>
    );
  };

  const actionPalette = selectedTask
    ? ({
        tarea: {
          gradient: ['#81243D', '#64172C', '#3B101D'] as const,
          accent: '#D18A9C',
          border: '#8C4056',
          text: '#F4E4E8',
          muted: '#D7B8C1',
          buttonBg: '#4E1525',
        },
        recordatorio: {
          gradient: ['#63303F', '#4A202D', '#32151E'] as const,
          accent: '#C58A98',
          border: '#79404F',
          text: '#F0E1E4',
          muted: '#D2B6BC',
          buttonBg: '#40202A',
        },
        nota: {
          gradient: ['#624657', '#493242', '#30202D'] as const,
          accent: '#D0A5BA',
          border: '#866176',
          text: '#F1E5EB',
          muted: '#D9C3CE',
          buttonBg: '#3B2938',
        },
        checklist: {
          gradient: ['#572A49', '#3D1C35', '#24101F'] as const,
          accent: '#C29AB8',
          border: '#74445F',
          text: '#F0E3EC',
          muted: '#D4BDCE',
          buttonBg: '#321B2D',
        },
      })[getTaskCategory(selectedTask)]
    : null;
  return (
    <View style={styles.container}>
      <ScrollView
        contentContainerStyle={styles.content}
        showsVerticalScrollIndicator={false}
        refreshControl={
          <RefreshControl
            refreshing={refreshing}
            onRefresh={onRefresh}
            tintColor={COLORS.brightWine}
          />
        }
      >
        <View style={styles.header}>
          <View style={styles.headerText}>
            <View style={styles.headerTitleRow}>
              <View style={styles.headerTitleBar} />
              <Text style={styles.headerTitle}>
                MI <Text style={styles.headerTitleAccent}>LIBRETA</Text>
              </Text>
            </View>
            <Text style={styles.subtitle}>
              Tus ideas y pendientes, organizados en un solo lugar.
            </Text>
          </View>

          <View style={styles.headerIcon}>
            <Lucide
              name="notebook-pen"
              size={25}
              color={COLORS.brightWine}
            />
          </View>
        </View>
<View style={styles.summarySection}>
          <View style={styles.summaryHeader}>
            <Text style={styles.summaryTitle}>RESUMEN DE MI LIBRETA</Text>
          </View>

          <View style={styles.summaryCard}>
            <View style={styles.summaryStat}>
              <View style={styles.summaryIcon}>
                <Lucide name="clipboard-list" size={19} color="#AA0330" />
              </View>
              <Text style={styles.summaryNumber}>{counts.tarea}</Text>
              <Text style={[styles.summaryLabel, { color: '#AA0330' }]}>
                TAREAS
              </Text>
            </View>

            <View style={styles.summaryDivider} />

            <View style={styles.summaryStat}>
              <View style={styles.summaryIcon}>
                <Lucide name="bell" size={19} color="#D17A91" />
              </View>
              <Text style={styles.summaryNumber}>{counts.recordatorio}</Text>
              <Text style={[styles.summaryLabel, { color: '#D17A91' }]}>
                RECORDATORIOS
              </Text>
            </View>

            <View style={styles.summaryDivider} />

            <View style={styles.summaryStat}>
              <View style={styles.summaryIcon}>
                <Lucide name="notebook-pen" size={19} color="#C9B8B1" />
              </View>
              <Text style={styles.summaryNumber}>
                {counts.nota + counts.checklist}
              </Text>
              <Text style={[styles.summaryLabel, { color: '#C9B8B1' }]}>
                NOTAS Y LISTAS
              </Text>
            </View>
          </View>
        </View>
<View style={styles.sectionHeading}>
          <Text style={styles.sectionTitle}>TU CONTENIDO</Text>
          <Text style={styles.totalLabel}>
            {tasks.length} {tasks.length === 1 ? 'elemento' : 'elementos'}
          </Text>
        </View>

        <View style={styles.searchRow}>
          <View style={styles.search}>
            <Lucide name="search" size={17} color={COLORS.brightWine} />
            <TextInput
              value={search}
              onChangeText={setSearch}
              placeholder="Buscar en mi libreta..."
              placeholderTextColor={COLORS.soft}
              style={styles.searchInput}
            />
            {!!search && (
              <Pressable onPress={() => setSearch('')}>
                <Lucide name="x" size={17} color={COLORS.muted} />
              </Pressable>
            )}
          </View>

          <Pressable
            style={styles.filterButton}
            onPress={() => setFiltersOpen(open => !open)}
          >
            <Lucide name="funnel" size={16} color={COLORS.brightWine} />
            <Text style={styles.filterButtonText}>Filtrar</Text>
            <Lucide
              name={filtersOpen ? 'chevron-up' : 'chevron-down'}
              size={16}
              color={COLORS.brightWine}
            />
          </Pressable>
        </View>


        {filtersOpen && (
          <View style={styles.filterPanel}>
            <Text style={styles.filterPanelTitle}>
              FILTRAR MI LIBRETA
            </Text>

            <Text style={styles.filterPanelSubtitle}>
              CATEGORÍAS
            </Text>

            <View style={styles.filterOptions}>
              {FILTERS.map(filter => {
                const isActive = activeFilter === filter.id;
                const count =
                  filter.id === 'todo' ? tasks.length : counts[filter.id];

                return (
                  <Pressable
                    key={filter.id}
                    onPress={() => setActiveFilter(filter.id)}
                    style={[
                      styles.filterOption,
                      isActive && styles.filterOptionActive,
                    ]}
                  >
                    <Text
                      style={[
                        styles.filterOptionText,
                        isActive && styles.filterOptionTextActive,
                      ]}
                    >
                      {filter.label}
                    </Text>

                    <Text
                      style={[
                        styles.filterOptionCount,
                        isActive && styles.filterOptionTextActive,
                      ]}
                    >
                      {count}
                    </Text>
                  </Pressable>
                );
              })}
            </View>

            {activeFilter !== 'todo' && (
              <Pressable
                style={styles.filterClearButton}
                onPress={() => setActiveFilter('todo')}
              >
                <Text style={styles.filterClearText}>
                  LIMPIAR FILTROS
                </Text>
              </Pressable>
            )}
          </View>
        )}
        <View style={styles.listHeading}>
          <Text style={styles.sectionTitle}>
            {activeFilter === 'todo'
              ? 'RECIENTES'
              : FILTERS.find(item => item.id === activeFilter)?.label.toUpperCase()}
          </Text>
        </View>

        {loading ? (
          <View style={styles.messageContainer}>
            <ActivityIndicator size="large" color={COLORS.brightWine} />
            <Text style={styles.messageText}>Organizando tu libreta...</Text>
          </View>
        ) : error ? (
          <View style={styles.messageContainer}>
            <Lucide name="cloud-alert" size={30} color={COLORS.soft} />
            <Text style={styles.messageText}>{error}</Text>
            <Pressable
              style={styles.retryButton}
              onPress={() => loadTasks()}
            >
              <Text style={styles.retryText}>VOLVER A INTENTAR</Text>
            </Pressable>
          </View>
        ) : filteredTasks.length === 0 ? (
          <View style={styles.emptyCard}>
            <View style={styles.emptyIcon}>
              <Lucide
                name="notebook-pen"
                size={29}
                color={COLORS.brightWine}
              />
            </View>
            <Text style={styles.emptyTitle}>
              {search
                ? 'No encontramos resultados'
                : activeFilter === 'todo'
                  ? 'Tu libreta está esperando'
                  : 'Todavía no hay contenido aquí'}
            </Text>
            <Text style={styles.emptyDescription}>
              {search
                ? 'Prueba con otra palabra.'
                : 'Crea tu primera nota, recordatorio o lista para comenzar.'}
            </Text>
          </View>
        ) : (
          <View style={styles.taskList}>
            {filteredTasks.map(renderTaskCard)}
          </View>
        )}
      </ScrollView>

      {showCreateMenu && (
        <Pressable
          style={styles.menuBackdrop}
          onPress={() => setShowCreateMenu(false)}
        >
          <View style={styles.createMenu}>
            <Text style={styles.menuTitle}>¿Qué deseas crear?</Text>

            <Pressable
              style={styles.menuOption}
              onPress={() => openForm('nota')}
            >
              <Lucide name="notebook-pen" size={20} color={COLORS.brightWine} />
              <View style={styles.menuOptionText}>
                <Text style={styles.menuOptionTitle}>Nueva nota</Text>
                <Text style={styles.menuOptionDescription}>
                  Guarda ideas y apuntes.
                </Text>
              </View>
            </Pressable>

            <Pressable
              style={styles.menuOption}
              onPress={() => openForm('recordatorio')}
            >
              <Lucide name="bell-ring" size={20} color={COLORS.brightWine} />
              <View style={styles.menuOptionText}>
                <Text style={styles.menuOptionTitle}>Nuevo recordatorio</Text>
                <Text style={styles.menuOptionDescription}>
                  Ten presentes tus pendientes.
                </Text>
              </View>
            </Pressable>

            <Pressable
              style={styles.menuOption}
              onPress={() => openForm('checklist')}
            >
              <Lucide name="list-checks" size={20} color={COLORS.brightWine} />
              <View style={styles.menuOptionText}>
                <Text style={styles.menuOptionTitle}>Nueva checklist</Text>
                <Text style={styles.menuOptionDescription}>
                  Divide tus tareas en pasos.
                </Text>
              </View>
            </Pressable>

            <Pressable
              style={styles.menuOption}
              onPress={() => openForm('tarea')}
            >
              <Lucide name="clipboard-list" size={20} color={COLORS.brightWine} />
              <View style={styles.menuOptionText}>
                <Text style={styles.menuOptionTitle}>Nueva tarea</Text>
                <Text style={styles.menuOptionDescription}>
                  Registra una actividad.
                </Text>
              </View>
            </Pressable>
          </View>
        </Pressable>
      )}

      <Modal
        visible={selectedTask !== null}
        transparent
        animationType="fade"
        onRequestClose={closeTaskActions}
      >
        <View style={styles.taskActionOverlay}>
          <Pressable
            style={StyleSheet.absoluteFill}
            onPress={closeTaskActions}
          />

          {selectedTask && actionPalette && (
            <LinearGradient
              style={[
                styles.taskActionPanel,
                { borderColor: actionPalette.border },
              ]}
              colors={actionPalette.gradient}
              start={{ x: 0, y: 0 }}
              end={{ x: 1, y: 1 }}
            >
              <View style={styles.taskActionHeader}>
                <Lucide
                  name="archive"
                  size={21}
                  color={actionPalette.accent}
                />
                <Text
                  style={[
                    styles.taskActionEyebrow,
                    { color: actionPalette.accent },
                  ]}
                >
                  GESTIONAR ACTIVIDAD
                </Text>
              </View>

              <Text
                style={[
                  styles.taskActionTitle,
                  { color: actionPalette.text },
                ]}
                numberOfLines={2}
              >
                {selectedTask.title}
              </Text>

              <Text
                style={[
                  styles.taskActionDescription,
                  { color: actionPalette.muted },
                ]}
              >
                ¿Qué deseas hacer con este contenido?
              </Text>

              <Pressable
                style={[
                  styles.taskActionButton,
                  {
                    backgroundColor: actionPalette.buttonBg,
                    borderColor: actionPalette.border,
                  },
                ]}
                onPress={archiveTask}
              >
                <Lucide
                  name="archive"
                  size={18}
                  color={actionPalette.accent}
                />
                <Text
                  style={[
                    styles.taskActionButtonText,
                    { color: actionPalette.text },
                  ]}
                >
                  Archivar
                </Text>
              </Pressable>

              <Pressable
                style={[
                  styles.taskActionButton,
                  styles.taskDeleteButton,
                  { borderColor: actionPalette.border },
                ]}
                onPress={deleteSelectedTask}
              >
                <Lucide name="trash-2" size={18} color="#E6A0B0" />
                <Text
                  style={[
                    styles.taskActionButtonText,
                    { color: '#F0C5CE' },
                  ]}
                >
                  Eliminar
                </Text>
              </Pressable>

              <Pressable
                style={styles.taskCancelButton}
                onPress={closeTaskActions}
              >
                <Text style={styles.taskCancelText}>Cancelar</Text>
              </Pressable>
            </LinearGradient>
          )}
        </View>
      </Modal>
      <Pressable
        style={styles.fab}
        onPress={() => setShowCreateMenu(current => !current)}
      >
        <Lucide
          name={showCreateMenu ? 'x' : 'plus'}
          size={25}
          color={COLORS.white}
        />
      </Pressable>

      <BottomNavigation
        activeScreen="Tasks"
        onHome={() => navigation.navigate('Home')}
        onSubjects={() => navigation.navigate('Subjects')}
        onTasks={() => navigation.navigate('Tasks')}
      />
    </View>
  );
}

