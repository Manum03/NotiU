import React, { useEffect, useRef, useState } from 'react';
import {
  ActivityIndicator,
  Alert,
  KeyboardAvoidingView,
  Modal,
  PanResponder,
  Platform,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  TextInput,
  View,
} from 'react-native';
import type { NativeStackScreenProps } from '@react-navigation/native-stack';
import { Lucide } from '@react-native-vector-icons/lucide';

import type { RootStackParamList } from '../../../navigation/AppNavigator';
import { FONTS } from '../../../core/theme/fonts';
import { apiRequest } from '../../../services/api/api';
import { getSession } from '../../../services/storage/authStorage';
import type { Subject, SubjectsResponse } from '../../subjects/types';
import { COLORS } from '../../subjects/types';

type Props = NativeStackScreenProps<RootStackParamList, 'AddTask'>;
type TaskType = 'tarea' | 'recordatorio' | 'nota';
type TaskPriority = 'baja' | 'media' | 'alta';

function OptionChip({
  label,
  selected,
  onPress,
}: {
  label: string;
  selected: boolean;
  onPress: () => void;
}) {
  return (
    <Pressable
      onPress={onPress}
      style={[styles.chip, selected && styles.chipSelected]}
    >
      <Text style={[styles.chipText, selected && styles.chipTextSelected]}>
        {label}
      </Text>
    </Pressable>
  );
}

export default function AddTaskScreen({ navigation, route }: Props) {
  const formMode = route.params?.type ?? 'tarea';
  const taskId = route.params?.taskId;
  const isEditing = Boolean(taskId);
  const [title, setTitle] = useState('');
  const [description, setDescription] = useState('');
  const [subtasks, setSubtasks] = useState<
  { id: string; title: string; completed: boolean }[]
>([]);
const [newSubtask, setNewSubtask] = useState('');
  const [type, setType] = useState<TaskType>(
  formMode === 'checklist'
    ? 'tarea'
    : formMode
);
  const [priority, setPriority] = useState<TaskPriority>('media');
  const [status, setStatus] = useState<
  'pendiente' | 'en_curso' | 'realizada'
>('pendiente');
  const [subjectId, setSubjectId] = useState<string | null>(null);
  const [dueDate, setDueDate] = useState('');
  const [dueTime, setDueTime] = useState('');
  const [datePickerVisible, setDatePickerVisible] = useState(false);
const [timePickerVisible, setTimePickerVisible] = useState(false);

const [calendarMonth, setCalendarMonth] = useState(new Date().getMonth());
const [calendarYear, setCalendarYear] = useState(new Date().getFullYear());

const [selectedHour, setSelectedHour] = useState('12');
const [selectedMinute, setSelectedMinute] = useState('00');
const [period, setPeriod] = useState<'AM' | 'PM'>('AM');
const [timeMode, setTimeMode] = useState<'hour' | 'minute'>('hour');
const timeModeRef = useRef(timeMode);
useEffect(() => { timeModeRef.current = timeMode; }, [timeMode]);
  const [subjects, setSubjects] = useState<Subject[]>([]);
  const [loadingSubjects, setLoadingSubjects] = useState(true);
  const [saving, setSaving] = useState(false);
  const [loadingTask, setLoadingTask] = useState(false);

  useEffect(() => {
    let active = true;

    async function loadSubjects() {
      try {
        const session = await getSession();
        if (!session?.token) return;

        const response = await apiRequest<SubjectsResponse>('/subjects', {
          method: 'GET',
          token: session.token,
        });

        if (active) setSubjects(response.data);
      } catch {
        if (active) {
          Alert.alert('Aviso', 'No se pudieron cargar las materias.');
        }
      } finally {
        if (active) setLoadingSubjects(false);
      }
    }

    loadSubjects();

    return () => {
      active = false;
    };
  }, []);
    useEffect(() => {
    if (!taskId) return;

    let active = true;

    async function loadTask() {
      try {
        setLoadingTask(true);

        const session = await getSession();

        if (!session?.token) {
          throw new Error('No se encontró una sesión activa.');
        }

        const response = await apiRequest<{
          task: {
            title: string;
            description: string;
            status: 'pendiente' | 'en_curso' | 'realizada';
            type: TaskType;
            priority: TaskPriority;
            subjectId: string | null;
            dueDate: string | null;
            dueTime: string | null;
            subtasks: {
              id: string;
              title: string;
              completed: boolean;
            }[];
          };
        }>(`/tasks/${taskId}`, {
          method: 'GET',
          token: session.token,
        });

        if (!active) return;

        const task = response.task;

        setTitle(task.title);
        setDescription(task.description ?? '');
        setType(task.type);
        setPriority(task.priority);
        setSubjectId(task.subjectId);
        setDueDate(task.dueDate ?? '');
        setDueTime(task.dueTime ?? '');
        setSubtasks(task.subtasks ?? []);
        setStatus(task.status);
      } catch (error) {
        if (active) {
          Alert.alert(
            'No se pudo cargar',
            error instanceof Error ? error.message : 'Inténtalo de nuevo.'
          );
        }
      } finally {
        if (active) setLoadingTask(false);
      }
    }

    loadTask();

    return () => {
      active = false;
    };
  }, [taskId]);

  const addSubtask = () => {
  const cleanTitle = newSubtask.trim();

  if (!cleanTitle) return;

  setSubtasks((current) => [
    ...current,
    {
      id: `${Date.now()}-${Math.random()}`,
      title: cleanTitle,
      completed: false,
    },
  ]);

  setNewSubtask('');
};
  const openDatePicker = () => {
    if (dueDate && /^\d{4}-\d{2}-\d{2}$/.test(dueDate)) {
      const [year, month] = dueDate.split('-').map(Number);
      setCalendarYear(year);
      setCalendarMonth(month - 1);
    }

    setDatePickerVisible(true);
  };

  const changeCalendarMonth = (amount: number) => {
    const newDate = new Date(calendarYear, calendarMonth + amount, 1);

    setCalendarMonth(newDate.getMonth());
    setCalendarYear(newDate.getFullYear());
  };

  const selectCalendarDate = (day: number) => {
    const formattedDate =
      `${calendarYear}-${String(calendarMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;

    setDueDate(formattedDate);
    setDatePickerVisible(false);
  };

  const openTimePicker = () => {
    if (dueTime && /^\d{2}:\d{2}$/.test(dueTime)) {
      const [hour, minute] = dueTime.split(':').map(Number);
      setSelectedHour(String(hour % 12 || 12).padStart(2, '0'));
      setSelectedMinute(String(minute).padStart(2, '0'));
      setPeriod(hour >= 12 ? 'PM' : 'AM');
    }

    setTimeMode('hour');
    setTimePickerVisible(true);
  };

  const confirmTime = () => {
    let hour24 = Number(selectedHour) % 12;

    if (period === 'PM') {
      hour24 += 12;
    }

    setDueTime(
      `${String(hour24).padStart(2, '0')}:${selectedMinute}`
    );
    setTimePickerVisible(false);
  };
  const updateClockFromTouch = (x: number, y: number) => {
    const center = 130;
    const dx = x - center;
    const dy = y - center;

    const angle = Math.atan2(dy, dx) + Math.PI / 2;
    const normalizedAngle = (angle + Math.PI * 2) % (Math.PI * 2);

    if (timeModeRef.current === 'hour') {
      const index = Math.round(normalizedAngle / (Math.PI / 6)) % 12;
      const hour = index === 0 ? 12 : index;

      setSelectedHour(String(hour).padStart(2, '0'));
    } else {
      // Cada grado representa un minuto: 00 hasta 59.
      const minute = Math.round(
        normalizedAngle / (Math.PI * 2) * 60
      ) % 60;

      setSelectedMinute(String(minute).padStart(2, '0'));
    }
  };

  const clockTouchStart = useRef({ x: 130, y: 130 });

  const clockPanResponder = useRef(
    PanResponder.create({
      onStartShouldSetPanResponder: () => true,
      onMoveShouldSetPanResponder: () => true,

      onPanResponderGrant: (event) => {
        const { locationX, locationY } = event.nativeEvent;

        clockTouchStart.current = {
          x: locationX,
          y: locationY,
        };

        updateClockFromTouch(locationX, locationY);
      },

      onPanResponderMove: (_, gestureState) => {
        const x = clockTouchStart.current.x + gestureState.dx;
        const y = clockTouchStart.current.y + gestureState.dy;

        updateClockFromTouch(x, y);
      },
    })
  ).current;
  const saveTask = async () => {
    if (!title.trim()) {
      Alert.alert('Falta el título', 'Escribe el nombre de la actividad.');
      return;
    }

    if (dueDate && !/^\d{4}-\d{2}-\d{2}$/.test(dueDate)) {
      Alert.alert('Fecha inválida', 'Usa el formato AAAA-MM-DD.');
      return;
    }

    if (dueTime && !/^([01]\d|2[0-3]):[0-5]\d$/.test(dueTime)) {
      Alert.alert('Hora inválida', 'Usa el formato de 24 horas, por ejemplo 14:30.');
      return;
    }

    try {
      setSaving(true);
      const session = await getSession();

      if (!session?.token) {
        throw new Error('No se encontró una sesión activa.');
      }

      await apiRequest(isEditing ? `/tasks/${taskId}` : '/tasks', {
        method: isEditing ? 'PATCH' : 'POST',
        token: session.token,
        body: JSON.stringify({
          title: title.trim(),
          description: description.trim(),
          type,
          priority,
          status,
          subjectId,
          dueDate: dueDate || null,
          dueTime: dueTime || null,
          subtasks: subtasks,
        }),
      });

Alert.alert(
  isEditing ? 'Actividad actualizada' : 'Actividad creada',
  isEditing
    ? 'Los cambios se guardaron correctamente.'
    : 'Se guardó correctamente.',
  [{ text: 'Aceptar', onPress: () => navigation.goBack() }]
);
    } catch (error) {
      Alert.alert(
        'No se pudo guardar',
        error instanceof Error ? error.message : 'Inténtalo de nuevo.'
      );
    } finally {
      setSaving(false);
    }
  };

  return (
    <KeyboardAvoidingView
      style={styles.screen}
      behavior={Platform.OS === 'ios' ? 'padding' : undefined}
    >
      <ScrollView
        contentContainerStyle={styles.content}
        keyboardShouldPersistTaps="handled"
        showsVerticalScrollIndicator={false}
      >
                <View style={styles.header}>
          <Pressable style={styles.backButton} onPress={() => navigation.goBack()}>
            <Lucide name="arrow-left" size={22} color={COLORS.text} />
          </Pressable>

          <View style={styles.headerText}>
  <Text style={styles.eyebrow}>MI LIBRETA</Text>

  <Text style={styles.heading}>
  {isEditing
    ? 'Editar actividad'
    : formMode === 'nota'
      ? 'Nueva nota'
      : formMode === 'recordatorio'
        ? 'Nuevo recordatorio'
        : formMode === 'checklist'
          ? 'Nueva checklist'
          : 'Nueva actividad'}
  </Text>

  <Text style={styles.subtitle}>
    {isEditing
  ? 'Guardar cambios'
  : formMode === 'nota'
    ? 'Guardar nota'
    : formMode === 'recordatorio'
      ? 'Guardar recordatorio'
      : formMode === 'checklist'
        ? 'Guardar checklist'
        : 'Guardar actividad'}
  </Text>
</View>


        </View>

        <View style={styles.formCard}>
          <Text style={styles.sectionTitle}>Información general</Text>

          <Text style={styles.label}>
  {formMode === 'nota'
    ? 'Nombre de la nota *'
    : formMode === 'recordatorio'
      ? 'Nombre del recordatorio *'
      : formMode === 'checklist'
        ? 'Nombre de la checklist *'
        : 'Nombre de la actividad *'}
</Text>
          <TextInput
            value={title}
            onChangeText={setTitle}
            placeholder={
  formMode === 'nota'
    ? 'Escribe tus ideas y apuntes aquí...'
    : formMode === 'checklist'
      ? 'Agrega una descripción para tu lista...'
      : 'Describe lo que necesitas realizar...'
}
            placeholderTextColor={COLORS.soft}
            style={styles.input}
            maxLength={100}
          />

          <Text style={styles.label}>
  {formMode === 'nota'
    ? 'Contenido de la nota'
    : formMode === 'checklist'
      ? 'Descripción (opcional)'
      : 'Descripción'}
</Text>
          <TextInput
            value={description}
            onChangeText={setDescription}
            placeholder="Agrega detalles (opcional)"
            placeholderTextColor={COLORS.soft}
            style={[styles.input, styles.textArea]}
            multiline
            textAlignVertical="top"
          />
                    {formMode === 'checklist' && (
            <>
              <View style={styles.divider} />

              <Text style={styles.sectionTitle}>Elementos de mi lista</Text>
              <Text style={styles.helper}>
                Agrega las actividades o pendientes que necesitas completar.
              </Text>

              <View style={styles.newSubtaskRow}>
                <TextInput
                  value={newSubtask}
                  onChangeText={setNewSubtask}
                  placeholder="Escribe un pendiente..."
                  placeholderTextColor={COLORS.soft}
                  style={styles.subtaskInput}
                  onSubmitEditing={addSubtask}
                  returnKeyType="done"
                />

                <Pressable
                  style={styles.addSubtaskButton}
                  onPress={addSubtask}
                >
                  <Lucide name="plus" size={21} color={COLORS.white} />
                </Pressable>
              </View>

              {subtasks.map((item) => (
  <View key={item.id} style={styles.subtaskItem}>
    <Pressable
      onPress={() =>
        setSubtasks((current) =>
          current.map((subtask) =>
            subtask.id === item.id
              ? { ...subtask, completed: !subtask.completed }
              : subtask
          )
        )
      }
    >
      <Lucide
        name={item.completed ? 'circle-check' : 'circle'}
        size={19}
        color={COLORS.brightWine}
      />
    </Pressable>

    <TextInput
      value={item.title}
      onChangeText={(value) =>
        setSubtasks((current) =>
          current.map((subtask) =>
            subtask.id === item.id
              ? { ...subtask, title: value }
              : subtask
          )
        )
      }
      placeholder="Nombre del pendiente..."
      placeholderTextColor={COLORS.soft}
      style={[
        styles.subtaskText,
        item.completed && {
          color: COLORS.soft,
          textDecorationLine: 'line-through',
        },
      ]}
    />

    <Pressable
      onPress={() =>
        setSubtasks((current) =>
          current.filter((subtask) => subtask.id !== item.id)
        )
      }
    >
      <Lucide name="trash-2" size={17} color={COLORS.muted} />
    </Pressable>
  </View>
))}
            </>
          )}
          {formMode === 'tarea' && (
  <>
    <Text style={styles.label}>Tipo de actividad</Text>

    <View style={styles.optionsRow}>
      <OptionChip
        label="Tarea"
        selected={type === 'tarea'}
        onPress={() => setType('tarea')}
      />
      <OptionChip
        label="Recordatorio"
        selected={type === 'recordatorio'}
        onPress={() => setType('recordatorio')}
      />
    </View>
  </>
)}
          <View style={styles.optionsRow}>
            <OptionChip
              label="Tarea"
              selected={type === 'tarea'}
              onPress={() => setType('tarea')}
            />
            <OptionChip
              label="Recordatorio"
              selected={type === 'recordatorio'}
              onPress={() => setType('recordatorio')}
            />
          </View>

          <Text style={styles.label}>Prioridad</Text>
          <View style={styles.optionsRow}>
            <OptionChip
              label="Baja"
              selected={priority === 'baja'}
              onPress={() => setPriority('baja')}
            />
            <OptionChip
              label="Media"
              selected={priority === 'media'}
              onPress={() => setPriority('media')}
            />
            <OptionChip
              label="Alta"
              selected={priority === 'alta'}
              onPress={() => setPriority('alta')}
            />
          </View>

          <View style={styles.divider} />

          <Text style={styles.sectionTitle}>Materia relacionada</Text>
          <Text style={styles.helper}>
  {formMode === 'nota'
    ? 'Puedes guardar esta nota dentro de una materia o mantenerla personal.'
    : formMode === 'recordatorio'
      ? 'Relaciona este recordatorio con una materia o déjalo independiente.'
      : formMode === 'checklist'
        ? 'Puedes vincular esta lista a una materia o mantenerla independiente.'
        : 'Puedes asociar esta actividad a una materia o dejarla independiente.'}
</Text>

          {loadingSubjects ? (
            <ActivityIndicator color={COLORS.brightWine} style={styles.loader} />
          ) : (
            <View style={styles.subjectList}>
              <OptionChip
                label="Sin materia"
                selected={subjectId === null}
                onPress={() => setSubjectId(null)}
              />
              {subjects.map((subject) => (
                <OptionChip
                  key={subject.id}
                  label={subject.name}
                  selected={subjectId === subject.id}
                  onPress={() => setSubjectId(subject.id)}
                />
              ))}
              {!subjects.length && (
                <Text style={styles.helper}>
                  Todavía no tienes materias registradas.
                </Text>
              )}
            </View>
          )}

            {formMode !== 'nota' && (
  <>
    <View style={styles.divider} />

    <Text style={styles.sectionTitle}>Fecha y hora</Text>
    <Text style={styles.helper}>
      Estos datos son opcionales.
    </Text>

    <Text style={styles.label}>
      {formMode === 'recordatorio'
        ? 'Fecha del recordatorio'
        : formMode === 'checklist'
          ? 'Fecha límite'
          : 'Fecha de entrega'}
    </Text>

    <Pressable
      style={styles.pickerField}
      onPress={openDatePicker}
    >
      <Text style={[
        styles.pickerFieldText,
        !dueDate && styles.pickerPlaceholder
      ]}>
        {dueDate || 'Seleccionar fecha'}
      </Text>
      <Lucide name="calendar-days" size={20} color={COLORS.brightWine} />
    </Pressable>

    <Text style={styles.label}>Hora</Text>

    <Pressable
      style={styles.pickerField}
      onPress={openTimePicker}
    >
      <Text style={[
        styles.pickerFieldText,
        !dueTime && styles.pickerPlaceholder
      ]}>
        {dueTime || 'Seleccionar hora'}
      </Text>
      <Lucide name="clock-3" size={21} color={COLORS.brightWine} />
    </Pressable>
  </>
)}


        </View>


        <Modal
          visible={datePickerVisible}
          transparent
          animationType="fade"
          onRequestClose={() => setDatePickerVisible(false)}
        >
          <View style={styles.modalOverlay}>
            <View style={styles.pickerModal}>
              <View style={styles.modalHeader}>
                <Text style={styles.modalTitle}>Selecciona una fecha</Text>
                <Pressable onPress={() => setDatePickerVisible(false)}>
                  <Lucide name="x" size={22} color={COLORS.text} />
                </Pressable>
              </View>

              <View style={styles.monthHeader}>
                <Pressable
                  style={styles.monthArrow}
                  onPress={() => changeCalendarMonth(-1)}
                >
                  <Lucide name="chevron-left" size={22} color={COLORS.text} />
                </Pressable>

                <Text style={styles.monthTitle}>
                  {['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
                    'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre',
                    'Diciembre'][calendarMonth]} {calendarYear}
                </Text>

                <Pressable
                  style={styles.monthArrow}
                  onPress={() => changeCalendarMonth(1)}
                >
                  <Lucide name="chevron-right" size={22} color={COLORS.text} />
                </Pressable>
              </View>

              <View style={styles.calendarGrid}>
                {['D', 'L', 'M', 'M', 'J', 'V', 'S'].map((day, index) => (
                  <View key={`weekday-${index}`} style={styles.calendarCell}>
                    <Text style={styles.weekdayText}>{day}</Text>
                  </View>
                ))}

                {Array.from(
                  { length: new Date(calendarYear, calendarMonth, 1).getDay() },
                  (_, index) => (
                    <View
                      key={`empty-${index}`}
                      style={styles.calendarCell}
                    />
                  )
                )}

                {Array.from(
                  { length: new Date(calendarYear, calendarMonth + 1, 0).getDate() },
                  (_, index) => {
                    const day = index + 1;
                    const dateValue =
                      `${calendarYear}-${String(calendarMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                    const selected = dueDate === dateValue;

                    return (
                      <Pressable
                        key={`day-${day}`}
                        style={[
                          styles.calendarCell,
                          styles.calendarDay,
                          selected && styles.calendarDaySelected,
                        ]}
                        onPress={() => selectCalendarDate(day)}
                      >
                        <Text
                          style={[
                            styles.calendarDayText,
                            selected && styles.calendarDayTextSelected,
                          ]}
                        >
                          {day}
                        </Text>
                      </Pressable>
                    );
                  }
                )}
              </View>

              <View style={styles.modalFooter}>
                <Pressable
                  onPress={() => {
                    setDueDate('');
                    setDatePickerVisible(false);
                  }}
                >
                  <Text style={styles.clearPickerText}>Limpiar</Text>
                </Pressable>
                <Pressable
                  style={styles.modalDoneButton}
                  onPress={() => setDatePickerVisible(false)}
                >
                  <Text style={styles.modalDoneText}>Listo</Text>
                </Pressable>
              </View>
            </View>
          </View>
        </Modal>
        <Modal
          visible={timePickerVisible}
          transparent
          animationType="fade"
          onRequestClose={() => setTimePickerVisible(false)}
        >
          <View style={styles.modalOverlay}>
            <View style={styles.pickerModal}>
              <View style={styles.modalHeader}>
                <Text style={styles.modalTitle}>Selecciona una hora</Text>
                <Pressable onPress={() => setTimePickerVisible(false)}>
                  <Lucide name="x" size={22} color={COLORS.text} />
                </Pressable>
              </View>

                            <View style={styles.digitalTimeRow}>
                <Pressable
                  style={[
                    styles.digitalTimeBox,
                    timeMode === 'hour' && styles.digitalTimeBoxActive,
                  ]}
                  onPress={() => setTimeMode('hour')}
                >
                  <Text style={styles.digitalTimeText}>{selectedHour}</Text>
                </Pressable>

                <Text style={styles.digitalTimeColon}>:</Text>

                <Pressable
                  style={[
                    styles.digitalTimeBox,
                    timeMode === 'minute' && styles.digitalTimeBoxActive,
                  ]}
                  onPress={() => setTimeMode('minute')}
                >
                  <Text style={styles.digitalTimeText}>{selectedMinute}</Text>
                </Pressable>

                <View style={styles.periodColumn}>
                  <Pressable
                    style={[
                      styles.periodButton,
                      period === 'AM' && styles.periodButtonActive,
                    ]}
                    onPress={() => setPeriod('AM')}
                  >
                    <Text style={[
                      styles.periodText,
                      period === 'AM' && styles.periodTextActive,
                    ]}>AM</Text>
                  </Pressable>

                  <Pressable
                    style={[
                      styles.periodButton,
                      period === 'PM' && styles.periodButtonActive,
                    ]}
                    onPress={() => setPeriod('PM')}
                  >
                    <Text style={[
                      styles.periodText,
                      period === 'PM' && styles.periodTextActive,
                    ]}>PM</Text>
                  </Pressable>
                </View>
              </View>

              <Text style={styles.clockInstruction}>
                {timeMode === 'hour'
                  ? 'Selecciona la hora'
                  : 'Selecciona los minutos'}
              </Text>

              <View
                style={styles.clockDial}
                {...clockPanResponder.panHandlers}
              >
                <View
                  style={[
                    styles.clockHand,
                    {
                      height: 95,
                      transform: [{
                        rotate: `${timeMode === 'hour'
                          ? (Number(selectedHour) % 12) * 30
                          : (Number(selectedMinute) / 60) * 360}deg`
                      }],
                    },
                  ]}
                />

                <View style={styles.clockCenter} />

                {Array.from({ length: 12 }, (_, index) => {
                  const angle = (index * 30 - 90) * Math.PI / 180;
                  const hourValue = index === 0 ? 12 : index;
                  const minuteValue = index * 5;

                  const selected = timeMode === 'hour'
                    ? Number(selectedHour) === hourValue
                    : Number(selectedMinute) === minuteValue;

                  return (
                    <Pressable
                      key={`clock-${index}`}
                      style={[
                        styles.clockNumber,
                        {
                          left: 130 + 100 * Math.cos(angle) - 17,
                          top: 130 + 100 * Math.sin(angle) - 17,
                        },
                        selected && styles.clockNumberSelected,
                      ]}
                      onPress={() => {
                        if (timeMode === 'hour') {
                          setSelectedHour(
                            String(hourValue).padStart(2, '0')
                          );
                          setTimeMode('minute');
                        } else {
                          setSelectedMinute(
                            String(minuteValue).padStart(2, '0')
                          );
                        }
                      }}
                    >
                      <Text style={[
                        styles.clockNumberText,
                        selected && styles.clockNumberTextSelected,
                      ]}>
                        {timeMode === 'hour'
                          ? hourValue
                          : String(minuteValue).padStart(2, '0')}
                      </Text>
                    </Pressable>
                  );
                })}
              </View>
<View style={styles.modalFooter}>
                <Pressable onPress={() => setTimePickerVisible(false)}>
                  <Text style={styles.clearPickerText}>Cancelar</Text>
                </Pressable>
                <Pressable
                  style={styles.modalDoneButton}
                  onPress={confirmTime}
                >
                  <Text style={styles.modalDoneText}>Confirmar</Text>
                </Pressable>
              </View>
            </View>
          </View>
        </Modal>
        <Pressable
          style={[styles.saveButton, saving && styles.disabledButton]}
          onPress={saveTask}
          disabled={saving}
        >
          {saving ? (
            <ActivityIndicator color={COLORS.white} />
          ) : (
            <>
              <Lucide name="check" size={19} color={COLORS.white} />
              <Text style={styles.saveText}>
  {formMode === 'nota'
    ? 'Guardar nota'
    : formMode === 'recordatorio'
      ? 'Guardar recordatorio'
      : formMode === 'checklist'
        ? 'Guardar checklist'
        : 'Guardar actividad'}
</Text>
            </>
          )}
        </Pressable>

        <Pressable
          style={styles.cancelButton}
          onPress={() => navigation.goBack()}
          disabled={saving}
        >
          <Text style={styles.cancelText}>Cancelar</Text>
        </Pressable>
      </ScrollView>
    </KeyboardAvoidingView>
  );
}

