# Copia este archivo como mobile/.env y llena los valores. Reinicia Expo después de cambiarlo.

# Dirección del backend. Usa la IP de tu computador en la red Wi-Fi (no "localhost"):
#   Linux/macOS: ip addr  |  Windows: ipconfig
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000/api

# Consola de Firebase > Configuración del proyecto > Tus apps > App web (</>) > Configuración del SDK
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=notiu-xxxxx.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=notiu-xxxxx
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=notiu-xxxxx.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Opcional: usar el emulador de Auth del backend (npm run emulators)
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR=http://192.168.x.x:9099

# Google Cloud Console (mismo proyecto de Firebase) > APIs y servicios > Credenciales >
# ID de cliente OAuth de tipo "Aplicación web" (el mismo GOOGLE_OAUTH_CLIENT_ID del backend).
# Se usa para "Continuar con Google" y para conectar Classroom (solo en development build).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
