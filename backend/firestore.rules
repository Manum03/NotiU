rules_version = '2';

// Todo el acceso a Firestore pasa por el backend (Firebase Admin SDK ignora estas reglas).
// La app móvil NUNCA lee ni escribe Firestore directamente: usa la API REST de NotiU.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
