# Copia este archivo como .env y llena los valores. NUNCA subas .env a git.

PORT=3000
NODE_ENV=development
APP_TIMEZONE=America/Bogota

# ---------- Firebase ----------
FIREBASE_PROJECT_ID=notiu-xxxxx

# Opción A (local): ruta al JSON de la cuenta de servicio
#   Consola Firebase > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Opción B (hosting): el JSON completo en una sola línea o en base64
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Opción C (sin credenciales): emuladores locales. Ejecuta `npm run emulators` y descomenta:
# FIREBASE_PROJECT_ID=demo-notiu
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Correos que serán admin automáticamente (separados por coma)
ADMIN_EMAILS=

# Llave para cifrar secretos. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ---------- Google Classroom (OAuth) ----------
# Google Cloud Console (mismo proyecto de Firebase) > APIs y servicios > Credenciales
# Usa el cliente OAuth de tipo "Aplicación web" (el mismo webClientId que usa la app móvil)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Vacío para serverAuthCode de Google Sign-In en Android/iOS
GOOGLE_OAUTH_REDIRECT_URI=

# ---------- Notificaciones push (Expo) ----------
# Solo si activas "Enhanced Security for Push Notifications" en expo.dev
EXPO_ACCESS_TOKEN=

# ---------- Jobs ----------
JOBS_ENABLED=true
SYNC_INTERVAL_MINUTES=30
REMINDER_CHECK_SECONDS=60
